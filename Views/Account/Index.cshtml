@model UDL.ViewModels.AccountViewModel
@{ Layout = "~/Views/Shared/_PublicLayout.cshtml"; ViewData["Title"] = "Mi cuenta"; }
<div class="page-intro"><div><div class="eyebrow">Cuenta UDL</div><h1>@Model.UserName<span class="blue">.</span></h1><p class="muted">@Model.Email</p></div></div>
<section class="reading-surface"><h2>Vínculo con jugador</h2>
    <div asp-validation-summary="All" class="form-errors" role="alert"></div>
    @if (Model.Player is not null)
    {
        <p class="spaced"><a class="text-link" href="@Url.Content($"~/players/{Model.Player.IdJugador}")">@Model.Player.NombreGD</a></p>
        <p class="muted">@(Model.Verified ? "Vínculo verificado." : "Vínculo provisional, no verificado. Seleccionar un nombre no acredita identidad ni otorga permisos sobre los records.")</p>
        @if (!Model.Verified) { <form method="post" action="@Url.Content("~/account/unlink")" class="actions">@Html.AntiForgeryToken()<button type="submit" class="btn secondary">Desvincular jugador</button></form> }
    }
    else
    {
        <p class="muted spaced">Tu cuenta todavía no tiene jugador asociado. Podés seleccionar uno libre como vínculo provisional; la verificación por el equipo de UDL se implementará más adelante.</p>
        <form method="get" action="@Url.Content("~/account")" class="actions"><label class="search"><input name="search" value="@Model.Search" type="search" maxlength="50" placeholder="NombreGD" aria-label="Buscar jugador" required></label><button type="submit" class="btn secondary">Buscar</button></form>
        @foreach (var player in Model.AvailablePlayers)
        {
            <form method="post" action="@Url.Content("~/account/link")" class="rankrow">
                @Html.AntiForgeryToken()<input type="hidden" name="idJugador" value="@player.IdJugador"><strong>@player.NombreGD</strong><button class="btn secondary" type="submit">Vincular provisionalmente</button>
            </form>
        }
        @if (Model.Search.Length > 0 && Model.AvailablePlayers.Count == 0) { <p class="muted spaced">No hay jugadores libres que coincidan con la búsqueda.</p> }
    }
</section>
